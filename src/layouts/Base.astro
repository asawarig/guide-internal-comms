---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import { meta } from "../content/guide";

interface Props {
  title?: string;
  description?: string;
}

const { title = meta.title, description = meta.tagline } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='12' fill='%23ff5a3c'/%3E%3C/svg%3E" />
  </head>

  <body>
    <header class="site-header">
      <div class="wrap site-header-inner">
        <a class="brand" href="/">
          <span class="brand-dot" aria-hidden="true"></span>
          <span>Plum</span>
          <span style="color: var(--ink-mute); font-family: var(--font-body); font-size: 0.85rem; margin-left: 8px;">
            Guides
          </span>
        </a>
        <ThemeToggle />
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Plum Benefits. Written for founders and heads of ops in Indian startups.</span>
        <span>Guide series · Internal comms</span>
      </div>
    </footer>
  </body>
</html>
