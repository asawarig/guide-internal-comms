---
import "../styles/global.css";
import BackToTop from "../components/BackToTop.astro";
import { meta } from "../content/guide";

interface Props {
  title?: string;
  description?: string;
}

const { title = meta.title, description = meta.tagline } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='6' y='6' width='20' height='20' fill='%23FF4052'/%3E%3C/svg%3E"
    />
  </head>

  <body>
    <header class="site-header">
      <div class="wrap site-header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>Plum</span>
          <span class="brand-eyebrow">Library</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="#why">the guide</a>
          <a href="#company-examples">examples</a>
          <a href="#take-away-pack">toolkit</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <span>plumhq.com · Library · Internal comms</span>
        <span>© {new Date().getFullYear()} Plum Benefits</span>
      </div>
    </footer>

    <BackToTop />
  </body>
</html>
