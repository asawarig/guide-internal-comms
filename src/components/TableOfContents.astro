---
import { parts } from "../content/guide";
---

<aside class="toc" aria-label="On this page">
  <p class="toc-label">The guide</p>
  {
    parts.map((part) => (
      <div class="toc-part">
        <div class="toc-part-head">
          <span class="toc-part-num">{part.romanNumeral}</span>
          <span class="toc-part-name">{part.title}</span>
        </div>
        <ul class="toc-list">
          {part.sections.map((s) => (
            <li>
              <a href={`#${s.id}`} data-toc-link={s.id}>
                <span class="toc-num">{s.number}</span>
                <span class="toc-text">{s.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
  <div class="toc-part toc-part-extra">
    <ul class="toc-list">
      <li>
        <a href="#company-examples" data-toc-link="company-examples">
          <span class="toc-num">◆</span>
          <span class="toc-text">How other companies do it</span>
        </a>
      </li>
      <li>
        <a href="#take-away-pack" data-toc-link="take-away-pack">
          <span class="toc-num">✂</span>
          <span class="toc-text">Take-away pack</span>
        </a>
      </li>
      <li>
        <a href="#sources" data-toc-link="sources">
          <span class="toc-num">↗</span>
          <span class="toc-text">Sources</span>
        </a>
      </li>
    </ul>
  </div>
</aside>

<script is:inline>
  (function () {
    var links = Array.from(document.querySelectorAll("[data-toc-link]"));
    if (!links.length) return;
    var byId = new Map();
    links.forEach(function (a) {
      byId.set(a.getAttribute("data-toc-link"), a);
    });
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          var link = byId.get(entry.target.id);
          if (!link) return;
          if (entry.isIntersecting) {
            links.forEach(function (l) {
              l.classList.remove("active");
            });
            link.classList.add("active");
          }
        });
      },
      { rootMargin: "-30% 0px -60% 0px", threshold: 0 }
    );
    byId.forEach(function (_link, id) {
      var el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  })();
</script>
