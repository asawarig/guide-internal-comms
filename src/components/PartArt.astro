---
// Small line illustrations per part: rituals, tools, norms.
// Pen-weight line drawings in plum-red on cream.
interface Props {
  variant: "rituals" | "tools" | "norms";
}
const { variant } = Astro.props;
---

<svg
  class="part-art"
  viewBox="0 0 120 120"
  width="72"
  height="72"
  role="img"
  aria-hidden="true"
>
  {
    variant === "rituals" && (
      <g fill="none" stroke="var(--plum-red)" stroke-width="1.5" stroke-linecap="round">
        <circle cx="60" cy="60" r="42" />
        <circle cx="60" cy="60" r="28" />
        <line x1="60" y1="18" x2="60" y2="30" />
        <line x1="60" y1="90" x2="60" y2="102" />
        <line x1="18" y1="60" x2="30" y2="60" />
        <line x1="90" y1="60" x2="102" y2="60" />
        <circle cx="60" cy="60" r="4" fill="var(--plum-red)" />
      </g>
    )
  }
  {
    variant === "tools" && (
      <g fill="none" stroke="var(--plum-red)" stroke-width="1.5" stroke-linecap="round">
        <rect x="20" y="28" width="80" height="64" />
        <line x1="20" y1="42" x2="100" y2="42" />
        <circle cx="28" cy="35" r="1.5" fill="var(--plum-red)" />
        <circle cx="34" cy="35" r="1.5" fill="var(--plum-red)" />
        <circle cx="40" cy="35" r="1.5" fill="var(--plum-red)" />
        <line x1="32" y1="58" x2="88" y2="58" />
        <line x1="32" y1="70" x2="72" y2="70" />
        <line x1="32" y1="82" x2="60" y2="82" />
      </g>
    )
  }
  {
    variant === "norms" && (
      <g fill="none" stroke="var(--plum-red)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 92 L60 22 L100 92 Z" />
        <line x1="42" y1="70" x2="78" y2="70" />
        <circle cx="60" cy="60" r="4" fill="var(--plum-red)" />
      </g>
    )
  }
</svg>

<style>
  .part-art {
    display: block;
  }
</style>
