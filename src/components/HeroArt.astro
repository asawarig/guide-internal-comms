---
// Lead illustration: how a company talks to itself.
// Nodes connected by ribbons — one loud, several quiet.
---

<svg class="hero-art" viewBox="0 0 500 400" role="img" aria-labelledby="hero-art-title">
  <title id="hero-art-title">A company talking to itself: overlapping ribbons connect a cluster of nodes</title>
  <defs>
    <linearGradient id="ribbon-a" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--coral)" stop-opacity="0.9" />
      <stop offset="1" stop-color="var(--coral)" stop-opacity="0.3" />
    </linearGradient>
    <linearGradient id="ribbon-b" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="var(--deep-purple-2)" stop-opacity="0.6" />
      <stop offset="1" stop-color="var(--deep-purple-2)" stop-opacity="0.15" />
    </linearGradient>
  </defs>

  <!-- background page -->
  <rect x="0" y="0" width="500" height="400" fill="var(--cream-2)" rx="22" />

  <!-- big loud ribbon -->
  <path
    d="M 40 120 C 140 20, 340 20, 460 140 C 340 260, 140 260, 40 120 Z"
    fill="url(#ribbon-a)"
    opacity="0.75"
  />

  <!-- quieter ribbon -->
  <path
    d="M 30 260 C 160 200, 320 320, 470 250"
    stroke="url(#ribbon-b)"
    stroke-width="28"
    fill="none"
    stroke-linecap="round"
  />

  <!-- nodes -->
  <g fill="var(--deep-purple)">
    <circle cx="90" cy="160" r="14" />
    <circle cx="180" cy="90" r="14" />
    <circle cx="260" cy="140" r="14" />
    <circle cx="360" cy="80" r="14" />
    <circle cx="420" cy="180" r="14" />
    <circle cx="140" cy="260" r="14" />
    <circle cx="240" cy="310" r="14" />
    <circle cx="360" cy="290" r="14" />
  </g>

  <!-- inner dots -->
  <g fill="var(--coral)">
    <circle cx="90" cy="160" r="5" />
    <circle cx="180" cy="90" r="5" />
    <circle cx="260" cy="140" r="5" />
    <circle cx="360" cy="80" r="5" />
    <circle cx="420" cy="180" r="5" />
    <circle cx="140" cy="260" r="5" />
    <circle cx="240" cy="310" r="5" />
    <circle cx="360" cy="290" r="5" />
  </g>

  <!-- one loud node -->
  <circle cx="260" cy="200" r="34" fill="var(--white)" stroke="var(--coral)" stroke-width="6" />
  <circle cx="260" cy="200" r="8" fill="var(--coral)" />

  <!-- connecting spokes -->
  <g stroke="var(--deep-purple)" stroke-width="1.2" opacity="0.35" fill="none">
    <line x1="260" y1="200" x2="90" y2="160" />
    <line x1="260" y1="200" x2="180" y2="90" />
    <line x1="260" y1="200" x2="360" y2="80" />
    <line x1="260" y1="200" x2="420" y2="180" />
    <line x1="260" y1="200" x2="140" y2="260" />
    <line x1="260" y1="200" x2="240" y2="310" />
    <line x1="260" y1="200" x2="360" y2="290" />
  </g>
</svg>
