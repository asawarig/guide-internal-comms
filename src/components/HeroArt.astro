---
// Editorial hero mark: a company talking to itself.
// One loud red ribbon carrying the signal, hairline echoes trailing behind,
// small nodes clustered along the paths. Pen-weight line drawing in plum-red
// on cream-deep, with the signature arrow-tipped rule as the base line.
---

<svg
  class="hero-art"
  viewBox="0 0 500 400"
  role="img"
  aria-labelledby="hero-art-title"
  aria-describedby="hero-art-desc"
>
  <title id="hero-art-title">A company talking to itself</title>
  <desc id="hero-art-desc">
    One loud red ribbon curls across the field, quieter hairlines echoing beneath it. Small nodes cluster along the paths. The signature arrow-tipped rule sits at the base.
  </desc>

  <!-- backdrop -->
  <rect x="0" y="0" width="500" height="400" fill="var(--cream-deep)" />

  <!-- quiet echo hairlines -->
  <g fill="none" stroke="var(--line-lavender)" stroke-width="1" stroke-linecap="round">
    <path d="M 30 130 C 130 90, 240 200, 350 130 S 460 200, 480 160" />
    <path d="M 30 250 C 140 210, 260 320, 380 260 S 460 300, 480 280" />
  </g>

  <!-- the loud red ribbon -->
  <path
    d="M 20 200 C 100 90, 220 300, 300 190 S 420 90, 490 220"
    fill="none"
    stroke="var(--plum-red)"
    stroke-width="2.5"
    stroke-linecap="round"
  />

  <!-- nodes along the paths -->
  <g fill="var(--fg-1)">
    <circle cx="80" cy="150" r="5" />
    <circle cx="150" cy="185" r="5" />
    <circle cx="220" cy="235" r="5" />
    <circle cx="380" cy="130" r="5" />
    <circle cx="440" cy="180" r="5" />
    <circle cx="120" cy="235" r="5" />
    <circle cx="260" cy="290" r="5" />
    <circle cx="380" cy="285" r="5" />
  </g>

  <!-- one loud node — the announcement -->
  <circle cx="300" cy="190" r="26" fill="var(--cream)" stroke="var(--plum-red)" stroke-width="2" />
  <circle cx="300" cy="190" r="9" fill="var(--plum-red)" />

  <!-- a tiny voice bubble hint -->
  <g fill="none" stroke="var(--fg-1)" stroke-width="1" opacity="0.55">
    <path d="M 300 155 Q 285 145, 285 130" />
    <path d="M 300 155 Q 315 145, 315 130" />
  </g>

  <!-- base signature: arrow-tipped rule -->
  <line x1="40" y1="360" x2="460" y2="360" stroke="var(--plum-red)" stroke-width="1" />
  <polygon points="34,360 42,356 42,364" fill="var(--plum-red)" />
  <polygon points="466,360 458,356 458,364" fill="var(--plum-red)" />

  <!-- small caption dots -->
  <g fill="var(--plum-red)">
    <circle cx="150" cy="378" r="1.5" />
    <circle cx="250" cy="378" r="1.5" />
    <circle cx="350" cy="378" r="1.5" />
  </g>
</svg>
