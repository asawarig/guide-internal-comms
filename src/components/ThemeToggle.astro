---
// Small light/dark toggle. Reads system preference by default, remembers a manual override in localStorage.
---

<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle colour mode">
  <span data-theme-icon>Dark</span>
</button>

<script is:inline>
  (function () {
    var key = "plum-guide-theme";
    var root = document.documentElement;
    var saved = null;
    try {
      saved = localStorage.getItem(key);
    } catch (e) {}

    function label(theme) {
      return theme === "dark" ? "Light" : "Dark";
    }

    function paint(theme) {
      root.setAttribute("data-theme", theme);
      var el = document.querySelector("[data-theme-icon]");
      if (el) el.textContent = label(theme);
    }

    var initial = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    paint(initial);

    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      try {
        localStorage.setItem(key, next);
      } catch (e) {}
      paint(next);
    });
  })();
</script>
