---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import HeroArt from "../components/HeroArt.astro";
import PartArt from "../components/PartArt.astro";
import TableOfContents from "../components/TableOfContents.astro";
import HeadcountStack from "../components/HeadcountStack.tsx";
import { companyExamples, intro, meta, parts, promise, sources, takeAways } from "../content/guide";
const toolkitHref = `${import.meta.env.BASE_URL}${meta.toolkitFileName}`.replace(/\/\//g, "/");
---

<Base>
  <!-- Mobile top nav: shows sections as pills -->
  <nav class="top-nav" aria-label="Sections">
    <div class="top-nav-inner">
      {
        parts.flatMap((part) =>
          part.sections.map((s) => (
            <a href={`#${s.id}`}>
              {s.number}. {s.title}
            </a>
          ))
        )
      }
    </div>
  </nav>

  <div class="wrap">
    <section class="hero">
      <div>
        <span class="hero-kicker">Plum guide · Internal comms</span>
        <h1 class="hero-title">{meta.title}</h1>
        <p class="hero-tagline">{meta.tagline}</p>
      </div>
      <HeroArt />
    </section>
  </div>

  <div class="wrap">
    <div class="layout">
      <TableOfContents />

      <div class="editorial">
        <section id="why" class="section" style="border-top: none; padding-top: 0;">
          <header class="section-header">
            <span class="section-number">§</span>
            <h2 class="section-title">{intro.heading}</h2>
          </header>
          {intro.paragraphs.map((p) => <p>{p}</p>)}
        </section>

        <section id="promise" class="section">
          <div class="promise">
            <h2>{promise.heading}</h2>
            <p style="margin-top:0;">{promise.intro}</p>
            <ul>
              {promise.items.map((i) => <li>{i}</li>)}
            </ul>
            <p style="margin-bottom:0; color: var(--ink-mute);">{promise.outro}</p>
          </div>
        </section>

        <section id="headcount" class="section">
          <div class="interactive-frame">
            <HeadcountStack client:load />
          </div>
        </section>

        {
          parts.map((part) => (
            <>
              <header id={part.id} class="part-opener">
                <span class="part-numeral">{part.romanNumeral}</span>
                <div class="part-title">
                  <PartArt variant={part.id as "rituals" | "tools" | "norms"} />
                  <h2>Part {part.romanNumeral}. {part.title}</h2>
                  <p>{part.blurb}</p>
                </div>
              </header>
              {part.sections.map((section) => (
                <Section section={section} />
              ))}
            </>
          ))
        }

        <section id="company-examples" class="pack">
          <header class="section-header">
            <span class="section-number">◆</span>
            <h2 class="section-title">{companyExamples.heading}</h2>
          </header>
          <p style="color: var(--ink-mute); max-width: 60ch;">{companyExamples.blurb}</p>
          {companyExamples.awaitingContent ? (
            <div class="examples-empty">
              <h3>Coming next</h3>
              <p style="margin:0;">
                Examples from real companies — the docs, wikis, and rituals worth stealing — will land here once
                they are gathered. Have one to nominate? Send it in.
              </p>
            </div>
          ) : (
            <div class="pack-grid">
              {companyExamples.examples.map((ex) => (
                <article class="pack-item">
                  <span class="num">◆</span>
                  <div>
                    <strong style="color: var(--deep-purple);">{ex.company}</strong>
                    <span style="color: var(--ink-mute); font-size: 0.85rem;"> · {ex.docType}</span>
                    <p style="margin: 4px 0 0;">{ex.blurb}</p>
                    {ex.sourceUrl && (
                      <a href={ex.sourceUrl} style="font-size: 0.85rem;" rel="noopener" target="_blank">
                        View source
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>

        <section id="take-away-pack" class="pack">
          <header class="section-header">
            <span class="section-number">✂</span>
            <h2 class="section-title">Take-away pack</h2>
          </header>
          <p style="color: var(--ink-mute); max-width: 60ch;">
            Every copy-paste asset from the guide, in one place. Each one lives inside its section too. Come back to
            this list when you are setting up a specific ritual or tool.
          </p>
          <div class="download-cta">
            <div>
              <h3>Download the full toolkit (.docx)</h3>
              <p>Every playbook, checklist, script, and template in a single Word document. Edit it, share it, print it.</p>
            </div>
            <a href={toolkitHref} download={meta.toolkitFileName}>Download .docx</a>
          </div>
          <div class="pack-grid">
            {
              takeAways.map((t) => (
                <a class="pack-item" href={`#${parts.flatMap((p) => p.sections).find((s) => s.number === t.section)?.id}`}>
                  <span class="num">{t.section}.</span>
                  <span>{t.title}</span>
                </a>
              ))
            }
          </div>
        </section>

        <section id="sources" class="sources">
          <header class="section-header">
            <span class="section-number">↗</span>
            <h2 class="section-title">Sources</h2>
          </header>
          <p style="color: var(--ink-mute); max-width: 60ch;">
            Primary sources only. Every stat on this page traces back to one of the reports below.
          </p>
          <ol>
            {
              sources.map((s) => (
                <li>
                  <strong>{s.label}. </strong>
                  {s.detail}
                </li>
              ))
            }
          </ol>
        </section>
      </div>
    </div>
  </div>
</Base>
