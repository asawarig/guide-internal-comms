---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

type Card = {
  tag: string;
  title: string;
  titleEm?: string;
  desc: string;
  meta: string;
  href?: string;
  state: "live" | "soon";
};

const cards: Card[] = [
  {
    tag: "Internal comms",
    title: "The Internal Comms",
    titleEm: "Blueprint",
    desc: "Pick your stage, headcount, work mode and the shape of your team. We print the comms playbook that fits — drawn from the full twelve-section Plum guide.",
    meta: "Build your own · 90 seconds · 12 sections",
    href: `${base}internal-communications/`,
    state: "live",
  },
  {
    tag: "Hiring",
    title: "The Hiring",
    titleEm: "Playbook",
    desc: "The interview rituals, offer letters and onboarding scripts that founders at 15, 50 and 150 people actually run. Tuned to your stage, like the Blueprint.",
    meta: "In the works",
    state: "soon",
  },
  {
    tag: "Benefits",
    title: "The Benefits",
    titleEm: "Benchmark",
    desc: "What funded startups, MNCs and Indian businesses actually offer their teams. Benchmarks from 15,000 benefit plans, with the sections that matter to buyers you'd compete with for talent.",
    meta: "In the works",
    state: "soon",
  },
];
---

<Base title="The Plum Library" description="Field guides for founders and heads of ops at Indian startups. Built as tools, not blog posts.">
  <!-- Masthead -->
  <header class="masthead" aria-label="Masthead">
    <div class="masthead-inner">
      <div class="masthead-eyebrow">
        <span class="masthead-eyebrow-rule" aria-hidden="true"></span>
        <span>Plum · The Library · Edition 01</span>
      </div>
      <h1>
        The Plum <em>Library</em>
      </h1>
      <p class="masthead-sub">
        Field guides for founders and heads of ops at Indian startups. Built
        as tools, not blog posts: each one takes five picks about your
        company and prints the version you'd actually run.
      </p>
      <div class="masthead-meta">
        <span>For founders, people success teams and heads of ops</span>
        <span>Indian startups · 5 to 150 people</span>
        <span>New editions added monthly</span>
      </div>
    </div>
  </header>

  <!-- Library grid -->
  <section class="library" aria-label="What's inside">
    <div class="library-inner">
      <div class="library-head">
        <span class="library-slug">What's inside</span>
        <h2 class="library-title">
          Three guides, each built around your <em>company</em>.
        </h2>
        <p class="library-sub">
          Pick the subject your week is stuck on. More editions in the queue.
        </p>
      </div>

      <ul class="library-grid">
        {cards.map((card) => (
          <li class={`library-card library-card-${card.state}`}>
            <a
              class="library-card-inner"
              href={card.state === "live" ? card.href : "#"}
              aria-disabled={card.state === "soon"}
              tabindex={card.state === "soon" ? -1 : 0}
            >
              <span class="library-card-tag">{card.tag}</span>
              <h3 class="library-card-title">
                {card.title}{" "}
                {card.titleEm && <em>{card.titleEm}</em>}
              </h3>
              <p class="library-card-desc">{card.desc}</p>
              <div class="library-card-foot">
                <span class="library-card-meta">{card.meta}</span>
                {card.state === "live" ? (
                  <span class="library-card-cta">Open the guide →</span>
                ) : (
                  <span class="library-card-cta library-card-cta-soon">Coming soon</span>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Colophon -->
  <footer class="colophon" aria-label="Colophon">
    <div class="colophon-row">
      <span class="colophon-slug">About the Library</span>
      <p>
        The Plum Library is a growing set of field guides for the operational
        muscle of a startup. Each guide is built around a configurator — you
        answer five things about your company and the guide prints the
        version that fits. Research from Plum's own customer data and
        primary sources only.
      </p>
    </div>
    <div class="colophon-row">
      <span class="colophon-slug">Credits</span>
      <p>
        Research and words: Plum editorial.<br />
        Design: Plum web.<br />
        Topic requests, grievances, counter-arguments: welcome, at the usual Plum address.
      </p>
    </div>
    <div class="colophon-row">
      <span class="colophon-slug">Elsewhere on plumhq.com</span>
      <p>
        <a href="https://www.plumhq.com/">Plum homepage →</a><br />
        <a href="https://www.plumhq.com/get-quote">Get a quote →</a>
      </p>
    </div>
  </footer>
</Base>
